# ─────────────────────────────────────────────
# Variables d'environnement — Backend FastAPI
# ─────────────────────────────────────────────
# Copie ce fichier en .env et remplis les valeurs
# Ne commit JAMAIS le fichier .env sur GitHub !

# Clé API Gemini (Google AI Studio — gratuit)
# Obtenir sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ta_cle_gemini_ici

# Adresse Gmail utilisée pour l'envoi des rapports
GMAIL_ADDRESS=ton.adresse@gmail.com

# Mot de passe d'application Gmail (pas ton vrai mot de passe !)
# Obtenir sur : Google Account → Sécurité → Mots de passe des applications
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
